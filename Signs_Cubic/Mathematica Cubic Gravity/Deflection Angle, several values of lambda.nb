        RowBox[{"C2Kot", ",", "\[Phi]min"}], "]"}]}], ")"}]}], ";"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]3Kot", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"AngleKot", "[", 
        RowBox[{"C2Kot", ",", 
         RowBox[{"\[Pi]", "/", "2"}]}], "]"}], "-", 
       RowBox[{"AngleKot", "[", 
        RowBox[{"C3Kot", ",", 
         RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}], ")"}]}], ";"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]sKot", "=", 
