Cell[CellGroupData[{

Cell["Schwarzschild  Triangulo", "Subsubsection",
 CellChangeTimes->{{3.94604348869174*^9, 3.946043531647499*^9}, {
  3.9460438041964417`*^9, 3.946043856156004*^9}, {3.9460440551988773`*^9, 
  3.946044063025509*^9}},ExpressionUUID->"6e35dea4-3ada-bf42-aab8-\
70f94be8f50e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"s0", "=", 
   RowBox[{
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[Epsilon]", "^", "2"}], "-", 
        RowBox[{
         RowBox[{"fUSch", "[", "u", "]"}], "*", 
         RowBox[{"u", "^", "2"}]}]}], "==", "0"}], ",", 
      RowBox[{"{", 
       RowBox[{"u", ",", "\[Epsilon]"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "2"}], "]"}], "]"}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Floor", "[", 
      RowBox[{"s0", "*", 
       RowBox[{"10", "^", "n"}]}], "]"}], "/", 
     RowBox[{"10", "^", "n"}]}], "//", "N"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"C1PhiMinSch", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"u", "'"}], "[", "\[Phi]", "]"}], ")"}], "^", "2"}], "-", 
         RowBox[{"\[Epsilon]", "^", "2"}], "+", 
         RowBox[{
          RowBox[{"fUSch", "[", 
           RowBox[{"u", "[", "\[Phi]", "]"}], "]"}], "*", 
          RowBox[{
           RowBox[{"u", "[", "\[Phi]", "]"}], "^", "2"}]}]}], "==", "0"}], 
       ",", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], "+", "\[Delta]val"}], "]"}], "==", 
        "s1"}]}], "}"}], ",", "u", ",", 
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", 
       RowBox[{
        RowBox[{"\[Pi]", "/", "2"}], "+", "\[Delta]val"}], ",", 
       "\[CapitalTheta]"}], "}"}], ",", 
     RowBox[{"Method", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<EquationSimplification\>\"", "->", "\"\<Residual\>\""}], 
       "}"}]}], ",", 
     RowBox[{"PrecisionGoal", "->", "45"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"C1PhiMaxSch", " ", "=", " ", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"u", "'"}], "[", "\[Phi]", "]"}], ")"}], "^", "2"}], "-", 
          RowBox[{"\[Epsilon]", "^", "2"}], "+", 
          RowBox[{
           RowBox[{"fUSch", "[", 
            RowBox[{"u", "[", "\[Phi]", "]"}], "]"}], "*", 
           RowBox[{
            RowBox[{"u", "[", "\[Phi]", "]"}], "^", "2"}]}]}], "==", "0"}], 
        ",", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], "-", "\[Delta]val"}], "]"}], "==", 
         "s1"}]}], "}"}], ",", "u", ",", 
      RowBox[{"{", 
       RowBox[{"\[Phi]", ",", 
        RowBox[{
         RowBox[{"\[Pi]", "/", "2"}], "-", "\[Delta]val"}], ",", 
        RowBox[{"\[Pi]", "-", "\[CapitalTheta]"}]}], "}"}], ",", 
      RowBox[{"Method", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<EquationSimplification\>\"", "->", "\"\<Residual\>\""}], 
        "}"}]}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Lados", " ", "Adyacentes", " ", "de", " ", "tri\[AAcute]ngulos"}],
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"C2Sch", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"u", "'"}], "[", "\[Phi]", "]"}], ")"}], "^", "2"}], "==", 
        RowBox[{
         RowBox[{"\[Epsilon]1", "^", "2"}], "-", 
         RowBox[{
          RowBox[{"fUSch", "[", 
           RowBox[{"u", "[", "\[Phi]", "]"}], "]"}], "*", 
          RowBox[{
           RowBox[{"u", "[", "\[Phi]", "]"}], "^", "2"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"u", "[", "\[Phi]min", "]"}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "\[Phi]", "]"}], "/.", "C1PhiMinSch"}], "/.", 
           RowBox[{"\[Phi]", "->", "\[Phi]min"}]}], ")"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", "u", ",", 
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", "\[Phi]min", ",", 
       RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
     RowBox[{"Method", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<EquationSimplification\>\"", "->", "\"\<Residual\>\""}], 
       "}"}]}], ",", 
     RowBox[{"PrecisionGoal", "->", "45"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"C3Sch", " ", "=", " ", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"u", "'"}], "[", "\[Phi]", "]"}], ")"}], "^", "2"}], "==", 
        RowBox[{
         RowBox[{"\[Epsilon]1", "^", "2"}], "-", 
         RowBox[{
          RowBox[{"fUSch", "[", 
           RowBox[{"u", "[", "\[Phi]", "]"}], "]"}], "*", 
          RowBox[{
           RowBox[{"u", "[", "\[Phi]", "]"}], "^", "2"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"u", "[", "\[Phi]max", "]"}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "\[Phi]", "]"}], "/.", "C1PhiMaxSch"}], "/.", 
           RowBox[{"\[Phi]", "->", "\[Phi]max"}]}], ")"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", "u", ",", 
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", 
       RowBox[{"\[Pi]", "/", "2"}], ",", "\[Phi]max"}], "}"}], ",", 
     RowBox[{"Method", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<EquationSimplification\>\"", "->", "\"\<Residual\>\""}], 
       "}"}]}], ",", 
     RowBox[{"PrecisionGoal", "->", "45"}]}], "]"}]}], ";"}]}], "Input",
