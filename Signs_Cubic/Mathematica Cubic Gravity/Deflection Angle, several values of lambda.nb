Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Kottler", " ", "Internal", " ", "Angles", " ", "Sum"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"AngleKot", "[", 
      RowBox[{"Sol_", ",", "\[Phi]v_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"3600", "*", 
        RowBox[{"180", "/", "\[Pi]"}], " ", 
        RowBox[{"(", 
         RowBox[{"ArcTan", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"u", "[", "\[Phi]", "]"}]}], " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"fUKot", "[", 
             RowBox[{"u", "[", "\[Phi]", "]"}], "]"}], "]"}], 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"u", "[", "\[Phi]", "]"}], ",", "\[Phi]"}], "]"}], "^", 
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}]}]}], " ", "]"}], ")"}]}], "/.", 
       "Sol"}], "/.", 
      RowBox[{"\[Phi]", "->", "\[Phi]v"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
