     RowBox[{"(", 
      RowBox[{
       RowBox[{"AngleKot", "[", 
        RowBox[{"C3Kot", ",", "\[Phi]max"}], "]"}], "-", 
       RowBox[{"AngleKot", "[", 
        RowBox[{"C1PhiMaxKot", ",", "\[Phi]max"}], "]"}]}], ")"}]}], ";"}], 
   " ", "\[IndentingNewLine]", 
   RowBox[{
