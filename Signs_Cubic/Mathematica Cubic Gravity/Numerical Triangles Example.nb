     RowBox[{"(", 
      RowBox[{"fKot", "[", 
       RowBox[{"1", "/", "u"}], "]"}], ")"}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Change", " ", "x"}], "->", 
     RowBox[{"1", "/", "u"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "Schwarzschild", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fSch", "[", "x_", "]"}], ":=", 
    RowBox[{"1", "-", 
     RowBox[{"1", "/", "x"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fUSch", "[", "u_", "]"}], ":=", 
    RowBox[{"fSch", "[", 
     RowBox[{"1", "/", "u"}], "]"}]}]}]}]], "Input",
