Cell[CellGroupData[{

Cell["Schwarzschild  Triangle", "Subsection",
 CellChangeTimes->{{3.9500003179461517`*^9, 
  3.9500003312233353`*^9}},ExpressionUUID->"9c541072-77cd-284f-8f53-\
0058ebb9f046"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Setting", " ", "the", " ", "condition", " ", 
     RowBox[{
      RowBox[{"u", "'"}], "[", 
      RowBox[{"\[Pi]", "/", "2"}], "]"}]}], "==", "0"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"s0", "=", 
     RowBox[{
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[Epsilon]", "^", "2"}], "-", 
          RowBox[{
           RowBox[{"fUSch", "[", "u", "]"}], "*", 
           RowBox[{"u", "^", "2"}]}]}], "==", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", "\[Epsilon]"}], "}"}]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], " ", ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s1", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Floor", "[", 
        RowBox[{"s0", "*", 
         RowBox[{"10", "^", "n"}]}], "]"}], "/", 
       RowBox[{"10", "^", "n"}]}], "//", "N"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Main", " ", "Geodesic"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"C1PhiMinSch", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"u", "'"}], "[", "\[Phi]", "]"}], ")"}], "^", "2"}], 
           "-", 
           RowBox[{"\[Epsilon]", "^", "2"}], "+", 
           RowBox[{
            RowBox[{"fUSch", "[", 
             RowBox[{"u", "[", "\[Phi]", "]"}], "]"}], "*", 
            RowBox[{
             RowBox[{"u", "[", "\[Phi]", "]"}], "^", "2"}]}]}], "==", "0"}], 
         ",", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{
            RowBox[{"\[Pi]", "/", "2"}], "+", "\[Delta]val"}], "]"}], "==", 
          "s1"}]}], "}"}], ",", "u", ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], "+", "\[Delta]val"}], ",", 
         "\[Phi]min"}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<EquationSimplification\>\"", "->", "\"\<Residual\>\""}],
          "}"}]}], ",", 
       RowBox[{"PrecisionGoal", "->", "45"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"C1PhiMaxSch", " ", "=", " ", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"u", "'"}], "[", "\[Phi]", "]"}], ")"}], "^", "2"}], 
           "-", 
           RowBox[{"\[Epsilon]", "^", "2"}], "+", 
           RowBox[{
            RowBox[{"fUSch", "[", 
             RowBox[{"u", "[", "\[Phi]", "]"}], "]"}], "*", 
            RowBox[{
             RowBox[{"u", "[", "\[Phi]", "]"}], "^", "2"}]}]}], "==", "0"}], 
         ",", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{
            RowBox[{"\[Pi]", "/", "2"}], "-", "\[Delta]val"}], "]"}], "==", 
          "s1"}]}], "}"}], ",", "u", ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], "-", "\[Delta]val"}], ",", 
         "\[Phi]max"}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<EquationSimplification\>\"", "->", "\"\<Residual\>\""}],
          "}"}]}], ",", 
       RowBox[{"PrecisionGoal", "->", "45"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Adjacent", " ", "Sides"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"C2Sch", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"u", "'"}], "[", "\[Phi]", "]"}], ")"}], "^", "2"}], "==", 
          RowBox[{
           RowBox[{"\[Epsilon]1", "^", "2"}], "-", 
           RowBox[{
            RowBox[{"fUSch", "[", 
             RowBox[{"u", "[", "\[Phi]", "]"}], "]"}], "*", 
            RowBox[{
             RowBox[{"u", "[", "\[Phi]", "]"}], "^", "2"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"u", "[", "\[Phi]min", "]"}], "==", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"u", "[", "\[Phi]", "]"}], "/.", "C1PhiMinSch"}], "/.", 
             RowBox[{"\[Phi]", "->", "\[Phi]min"}]}], ")"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", "u", ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", "\[Phi]min", ",", 
         RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<EquationSimplification\>\"", "->", "\"\<Residual\>\""}],
          "}"}]}], ",", 
       RowBox[{"PrecisionGoal", "->", "45"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"C3Sch", " ", "=", " ", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"u", "'"}], "[", "\[Phi]", "]"}], ")"}], "^", "2"}], "==", 
          RowBox[{
           RowBox[{"\[Epsilon]1", "^", "2"}], "-", 
           RowBox[{
            RowBox[{"fUSch", "[", 
             RowBox[{"u", "[", "\[Phi]", "]"}], "]"}], "*", 
            RowBox[{
             RowBox[{"u", "[", "\[Phi]", "]"}], "^", "2"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"u", "[", "\[Phi]max", "]"}], "==", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"u", "[", "\[Phi]", "]"}], "/.", "C1PhiMaxSch"}], "/.", 
             RowBox[{"\[Phi]", "->", "\[Phi]max"}]}], ")"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", "u", ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", 
         RowBox[{"\[Pi]", "/", "2"}], ",", "\[Phi]max"}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<EquationSimplification\>\"", "->", "\"\<Residual\>\""}],
          "}"}]}], ",", 
       RowBox[{"PrecisionGoal", "->", "45"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9500003732411404`*^9, 3.950000379504135*^9}, {
  3.9500024500958614`*^9, 
  3.9500025016176243`*^9}},ExpressionUUID->"bc18624a-c1a6-d842-a082-\
597bf697712c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Angular Difference", "Subsection",
 CellChangeTimes->{{3.950002643868889*^9, 
  3.9500026488165607`*^9}},ExpressionUUID->"f4e425f9-8795-ad45-8a0c-\
d13368bc9af5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"\[Beta]1", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"C3", "-", "C1"}], "|", 
      RowBox[{"\[Phi]max", "  ", "\[Beta]2"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"C1", "-", "C2"}], "|", 
       RowBox[{"\[Phi]min", "  ", "\[Beta]3"}]}], "=", 
      RowBox[{
       RowBox[{"C2", "-", "C3"}], "|", 
       RowBox[{"\[Pi]", "/", "2"}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Kottler", " ", "Internal", " ", "Angles"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"AngleKot", "[", 
      RowBox[{"Sol_", ",", "\[Phi]v_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"3600", "*", 
        RowBox[{"180", "/", "\[Pi]"}], " ", 
        RowBox[{"(", 
         RowBox[{"ArcTan", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"u", "[", "\[Phi]", "]"}]}], " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"fUKot", "[", 
             RowBox[{"u", "[", "\[Phi]", "]"}], "]"}], "]"}], 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"u", "[", "\[Phi]", "]"}], ",", "\[Phi]"}], "]"}], "^", 
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}]}]}], " ", "]"}], ")"}]}], "/.", 
       "Sol"}], "/.", 
      RowBox[{"\[Phi]", "->", "\[Phi]v"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]1Kot", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"AngleKot", "[", 
        RowBox[{"C3Kot", ",", "\[Phi]max"}], "]"}], "-", 
       RowBox[{"AngleKot", "[", 
        RowBox[{"C1PhiMaxKot", ",", "\[Phi]max"}], "]"}]}], ")"}]}], ";"}], 
   " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]2Kot", "=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"AngleKot", "[", 
        RowBox[{"C1PhiMinKot", ",", "\[Phi]min"}], "]"}], "-", 
       RowBox[{"AngleKot", "[", 
        RowBox[{"C2Kot", ",", "\[Phi]min"}], "]"}]}], ")"}]}], ";"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]3Kot", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"AngleKot", "[", 
        RowBox[{"C2Kot", ",", 
         RowBox[{"\[Pi]", "/", "2"}]}], "]"}], "-", 
       RowBox[{"AngleKot", "[", 
        RowBox[{"C3Kot", ",", 
         RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}], ")"}]}], ";"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]sKot", "=", 
     RowBox[{"\[Beta]1Kot", "+", "\[Beta]2Kot", "+", "\[Beta]3Kot"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Schwarzschild", " ", "Internal", " ", "Angles"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"AngleSch", "[", 
      RowBox[{"Sol_", ",", "\[Phi]v_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"3600", "*", 
        RowBox[{"180", "/", "\[Pi]"}], " ", 
        RowBox[{"ArcTan", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"u", "[", "\[Phi]", "]"}]}], " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"fUSch", "[", 
            RowBox[{"u", "[", "\[Phi]", "]"}], "]"}], "]"}], 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"u", "[", "\[Phi]", "]"}], ",", "\[Phi]"}], "]"}], "^", 
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}]}]}], "]"}]}], "/.", "Sol"}], "/.", 
      RowBox[{"\[Phi]", "->", "\[Phi]v"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]1Sch", "=", 
     RowBox[{
      RowBox[{"AngleSch", "[", 
       RowBox[{"C3Sch", ",", "\[Phi]max"}], "]"}], "-", 
      RowBox[{"AngleSch", "[", 
       RowBox[{"C1PhiMaxSch", ",", "\[Phi]max"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]2Sch", "=", 
     RowBox[{
      RowBox[{"AngleSch", "[", 
       RowBox[{"C1PhiMinSch", ",", "\[Phi]min"}], "]"}], "-", 
      RowBox[{"AngleSch", "[", 
       RowBox[{"C2Sch", ",", "\[Phi]min"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]3Sch", "=", 
     RowBox[{
      RowBox[{"AngleSch", "[", 
       RowBox[{"C2Sch", ",", 
