Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Kottler", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fKot", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"1", "-", 
