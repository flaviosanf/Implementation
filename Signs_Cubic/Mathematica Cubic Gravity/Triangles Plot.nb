Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Triangle", " ", "Base"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"C1PhiMinECG", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"u", "'"}], "[", "\[Phi]", "]"}], ")"}], "^", "2"}], 
           "-", 
           RowBox[{"\[Epsilon]", "^", "2"}], "+", 
           RowBox[{
            RowBox[{"fUECG", "[", 
             RowBox[{"u", "[", "\[Phi]", "]"}], "]"}], "*", 
            RowBox[{
             RowBox[{"u", "[", "\[Phi]", "]"}], "^", "2"}]}]}], "==", "0"}], 
         ",", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"\[Pi]", "/", "2"}], "]"}], "==", "0.2978138"}]}], "}"}], 
       ",", "u", ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", 
         RowBox[{"\[Pi]", "/", "2"}], ",", "\[CapitalTheta]"}], "}"}], ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<EquationSimplification\>\"", "->", "\"\<Residual\>\""}],
          "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"C1PhiMaxECG", " ", "=", " ", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"u", "'"}], "[", "\[Phi]", "]"}], "^", "2"}], "-", 
           RowBox[{"\[Epsilon]", "^", "2"}], "+", 
           RowBox[{
            RowBox[{"fUECG", "[", 
             RowBox[{"u", "[", "\[Phi]", "]"}], "]"}], "*", 
            RowBox[{
             RowBox[{"u", "[", "\[Phi]", "]"}], "^", "2"}]}]}], "==", "0"}], 
         ",", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"\[Pi]", "/", "2"}], "]"}], "==", "0.2978138"}]}], "}"}], 
       ",", "u", ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", 
         RowBox[{"\[Pi]", "/", "2"}], ",", 
         RowBox[{"\[Pi]", "-", "\[CapitalTheta]"}]}], "}"}], ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<EquationSimplification\>\"", "->", "\"\<Residual\>\""}],
          "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Adjacent", " ", "Sides"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"C3ECG", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"u", "'"}], "[", "\[Phi]", "]"}], ")"}], "^", "2"}], "==", 
          RowBox[{
           RowBox[{"\[Epsilon]1", "^", "2"}], "-", 
           RowBox[{
            RowBox[{"fUECG", "[", 
             RowBox[{"u", "[", "\[Phi]", "]"}], "]"}], "*", 
            RowBox[{
             RowBox[{"u", "[", "\[Phi]", "]"}], "^", "2"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"u", "[", "\[Phi]max", "]"}], "==", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"u", "[", "\[Phi]", "]"}], "/.", "C1PhiMaxECG"}], "/.", 
              RowBox[{"\[Phi]", "->", "\[Phi]max"}]}], ")"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], ")"}]}]}], "}"}], ",", "u", ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", "\[Phi]max", ",", 
         RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<EquationSimplification\>\"", "->", "\"\<Residual\>\""}],
          "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"C2ECG", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"u", "'"}], "[", "\[Phi]", "]"}], ")"}], "^", "2"}], "==", 
          RowBox[{
           RowBox[{"\[Epsilon]1", "^", "2"}], "-", 
           RowBox[{
            RowBox[{"fUECG", "[", 
             RowBox[{"u", "[", "\[Phi]", "]"}], "]"}], "*", 
            RowBox[{
             RowBox[{"u", "[", "\[Phi]", "]"}], "^", "2"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"u", "[", "\[Phi]min", "]"}], "==", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"u", "[", "\[Phi]", "]"}], "/.", "C1PhiMinECG"}], "/.", 
             RowBox[{"\[Phi]", "->", "\[Phi]min"}]}], ")"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", "u", ",", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", "\[Phi]min", ",", 
         RowBox[{"\[Pi]", "/", "2"}]}], "}"}], ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<EquationSimplification\>\"", "->", "\"\<Residual\>\""}],
          "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "Ploting", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PltC1ECG", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ParametricPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
