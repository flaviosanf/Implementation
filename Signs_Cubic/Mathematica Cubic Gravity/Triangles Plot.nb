            RowBox[{
             RowBox[{"1", "/", 
              RowBox[{"u", "[", "\[Phi]", "]"}]}], " ", 
             RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], "}"}], "/.", 
          "C1PhiMinECG"}], ",", 
