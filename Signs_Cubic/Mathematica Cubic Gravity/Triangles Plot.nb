Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Kottler", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"EqmAdim", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["x", "3"]}], "+", 
       RowBox[{
        SuperscriptBox["x", "5"], " ", "\[CapitalLambda]b"}], "+", 
       RowBox[{
        SuperscriptBox["x", "4"], " ", 
        RowBox[{
         SuperscriptBox["f", "\[Prime]",
          MultilineFunction->None], "[", "x", "]"}]}], "-", 
       RowBox[{"12", " ", "x", " ", "\[Lambda]b", " ", 
        SuperscriptBox[
         RowBox[{
          SuperscriptBox["f", "\[Prime]",
           MultilineFunction->None], "[", "x", "]"}], "2"]}], "-", 
       RowBox[{"24", " ", "\[Lambda]b", " ", 
        SuperscriptBox[
         RowBox[{"f", "[", "x", "]"}], "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{
            SuperscriptBox["f", "\[Prime]",
             MultilineFunction->None], "[", "x", "]"}]}], "+", 
          RowBox[{"x", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              RowBox[{
               SuperscriptBox["f", "\[Prime]\[Prime]",
                MultilineFunction->None], "[", "x", "]"}]}], "+", 
             RowBox[{"x", " ", 
              RowBox[{
               SuperscriptBox["f", 
                TagBox[
                 RowBox[{"(", "3", ")"}],
                 Derivative],
                MultilineFunction->None], "[", "x", "]"}]}]}], ")"}]}]}], 
         ")"}]}], "+", 
       RowBox[{
        RowBox[{"f", "[", "x", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"48", " ", "x", " ", "\[Lambda]b", " ", 
           SuperscriptBox[
            RowBox[{
             SuperscriptBox["f", "\[Prime]",
              MultilineFunction->None], "[", "x", "]"}], "2"]}], "+", 
          RowBox[{"12", " ", "\[Lambda]b", " ", 
           RowBox[{
            SuperscriptBox["f", "\[Prime]",
             MultilineFunction->None], "[", "x", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"4", "-", 
             RowBox[{"4", " ", 
              SuperscriptBox["x", "2"], " ", 
              RowBox[{
               SuperscriptBox["f", "\[Prime]\[Prime]",
                MultilineFunction->None], "[", "x", "]"}]}], "+", 
             RowBox[{
              SuperscriptBox["x", "3"], " ", 
              RowBox[{
               SuperscriptBox["f", 
                TagBox[
                 RowBox[{"(", "3", ")"}],
                 Derivative],
                MultilineFunction->None], "[", "x", "]"}]}]}], ")"}]}], "+", 
          RowBox[{"x", " ", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["x", "2"], "-", 
             RowBox[{"48", " ", "\[Lambda]b", " ", 
              RowBox[{
               SuperscriptBox["f", "\[Prime]\[Prime]",
                MultilineFunction->None], "[", "x", "]"}]}], "+", 
             RowBox[{"12", " ", 
              SuperscriptBox["x", "2"], " ", "\[Lambda]b", " ", 
              SuperscriptBox[
               RowBox[{
                SuperscriptBox["f", "\[Prime]\[Prime]",
                 MultilineFunction->None], "[", "x", "]"}], "2"]}], "+", 
             RowBox[{"24", " ", "x", " ", "\[Lambda]b", " ", 
              RowBox[{
               SuperscriptBox["f", 
                TagBox[
                 RowBox[{"(", "3", ")"}],
                 Derivative],
                MultilineFunction->None], "[", "x", "]"}]}]}], ")"}]}]}], 
         ")"}]}]}], "/.", 
      RowBox[{"\[Lambda]b", "->", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fNum", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"EqmAdim", "==", "0"}], ",", 
          RowBox[{
           RowBox[{"f", "[", "1", "]"}], "==", "0"}]}], "}"}], "/.", 
        RowBox[{"\[CapitalLambda]b", "->", 
         RowBox[{"1.5", "*", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"-", "32"}], ")"}]}]}]}]}], ",", "f", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "1", ",", "50"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fUNum", "[", "u_", "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"1", "/", "u"}], "]"}], "/.", " ", 
       RowBox[{"fNum", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], ";"}], 
   RowBox[{"(*", 
